# Copy this file to .env and fill in real values.
# .env is auto-loaded by demo.py and compare_demo.py (python-dotenv).
# Never commit your real .env -- it contains secrets.

# --- Jev side (harness/) ---
# offline (default) | adapter | live
DEMO_MODE=offline

# --- Strands Decider side (harness_decider/) ---
# offline (default) | live
DECIDER_MODE=offline

# --- Required for DEMO_MODE=live or DEMO_MODE=adapter (Bedrock reasoning + adapter decisions) ---
# Bedrock API key (bearer token), NOT an IAM access key/secret.
# Get this from the Bedrock console -> API keys -> generate a key, and paste
# the actual key VALUE here (not its name/label).
AWS_BEARER_TOKEN_BEDROCK=

# Region where your Bedrock model access is enabled for this key.
AWS_REGION=us-west-2

# Model used for LangChain/Bedrock reasoning (harness/lc_model.py) and for
# adapter-mode decisions (harness/jev_router.py's _BedrockSystemOneProvider).
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Required for DEMO_MODE=live only (the real hosted Jev/TypeSafe model) ---
TYPESAFE_API_KEY=

# --- Required for DECIDER_MODE=live only (the real local strands-decider-2b model) ---
# Optional override; defaults to StrandsAgents/strands-decider-2B-hobson-v19 if unset.
DECIDER_MODEL_ID=
